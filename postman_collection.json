{
  "info": {
    "name": "Task Manager API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "Create Task",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Buy milk\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] }
      }
    },
    {
      "name": "List All Tasks",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] }
      }
    },
    {
      "name": "List Pending Tasks",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/tasks?filter=pending",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"],
          "query": [{ "key": "filter", "value": "pending" }]
        }
      }
    },
    {
      "name": "List Done Tasks",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/tasks?filter=done",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"],
          "query": [{ "key": "filter", "value": "done" }]
        }
      }
    },
    {
      "name": "Mark Task Done",
      "request": {
        "method": "PATCH",
        "url": { "raw": "{{baseUrl}}/tasks/1/done", "host": ["{{baseUrl}}"], "path": ["tasks", "1", "done"] }
      }
    },
    {
      "name": "Delete Task",
      "request": {
        "method": "DELETE",
        "url": { "raw": "{{baseUrl}}/tasks/1", "host": ["{{baseUrl}}"], "path": ["tasks", "1"] }
      }
    }
  ]
}
